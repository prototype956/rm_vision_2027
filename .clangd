# rm_vision_2027 clangd 配置（兼容 Ubuntu 22.04 clangd 14）
CompileFlags:
  CompilationDatabase: build/

Diagnostics:
  # clangd 14 解析 GCC 11 标准库和 SSE 内建函数时的已知误报。
  Suppress:
    - invalid_consteval_call
    - builtin_definition

InlayHints:
  # 避免 clangd 14 处理部分 static constexpr 表达式时崩溃。
  DeducedTypes: No
